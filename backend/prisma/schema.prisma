generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------
enum Gender {
  MALE
  FEMALE
}

enum InteractionType {
  LIKE
  PASS
  BLOCK
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model User {
  id              String   @id @default(uuid())
  phoneNumber     String   @unique
  name            String?
  bio             String?
  gender          Gender?
  contactId       String?  // آیدی ارتباطی مستقیم
  showPhoneNumber Boolean  @default(false)
  birthDate       DateTime?
  
  city            String?
  latitude        Float?
  longitude       Float?

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contactInfo     ContactInfo?
  photos          Photo[]
  
  matchesAsUser1  Match[] @relation("MatchUser1")
  matchesAsUser2  Match[] @relation("MatchUser2")

  reportsMade     Report[] @relation("Reporter")
  reportsReceived Report[] @relation("Reported")

  // روابط تعاملات (نسخه اصلاح شده و بدون تکرار)
  sentInteractions     Interaction[] @relation("Swiper")
  receivedInteractions Interaction[] @relation("Target")

  // روابط چت
  sentMessages         Message[]     @relation("SentMessages")
  receivedMessages     Message[]     @relation("ReceivedMessages")
}

model ContactInfo {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  telegramId          String?
  instagramId         String?
  phoneForContact     String?
  
  isContactShareEnabled Boolean  @default(false)
}

model Photo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Match {
  id        String   @id @default(uuid())
  user1Id   String
  user1     User     @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String
  user2     User     @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId  String
  reported    User         @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason      String       @db.Text
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
}

model Interaction {
  id        String          @id @default(uuid())
  swiperId  String
  targetId  String
  type      InteractionType
  createdAt DateTime        @default(now())

  swiper    User            @relation("Swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  target    User            @relation("Target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}